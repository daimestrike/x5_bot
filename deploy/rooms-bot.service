# Справочный шаблон. Проще выполнить: sudo ./deploy/install-service.sh
# Он подставит каталог, пользователя и путь к python3 и проверит конфигурацию.
# Вручную: заменить /opt/rooms-bot и botuser, затем
#   sudo cp deploy/rooms-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rooms-bot
[Unit]
Description=Справочник Аватара — бот Rooms
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/rooms-bot
# Системный python3: зависимости берутся из /opt/rooms-bot/vendor, .venv не нужен
ExecStart=/usr/bin/python3 /opt/rooms-bot/run.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
