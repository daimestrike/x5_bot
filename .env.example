# Demo processes local test events. It does not connect to X5 Rooms.
# The demo-* values below are PUBLIC and intentionally fake: anyone can open the dev console with them.
# Production refuses them; generate real secrets with: python scripts/init_env.py --secure
BOT_MODE=demo
ENABLE_DEV_CONSOLE=true
BOT_API_TOKEN=demo-api-token-for-local-console-only-00000
METRICS_TOKEN=demo-metrics-token-for-local-only-000000
BOT_STATE_SECRET=demo-state-secret-for-local-only-00000000
CONTENT_DIR=content
DB_PATH=data/bot-v2.sqlite3
SESSION_TTL_SECONDS=14400
RETENTION_DAYS=30
REQUESTS_PER_MINUTE=300

# eXpress BotX v4 (Rooms). Read docs/ROOMS-INTEGRATION.md before enabling production.
# HTTPS origin CTS; used when ROOMS_TOKEN_URL / ROOMS_SEND_URL are empty
ROOMS_API_BASE_URL=
# BOT_ID (UUID) from the Rooms administrator
ROOMS_BOT_ID=
# JWT issuer of incoming /command requests
ROOMS_ISSUER=
# BOT_SECRET: signs the token request and verifies incoming JWT
ROOMS_SECRET_KEY=
# corporate CA bundle (optional)
ROOMS_CA_FILE=
# the wiki example runs with VERIFY_SSL=False; keep true unless the gateway forces it
ROOMS_VERIFY_TLS=true
ROOMS_CONTRACT_CONFIRMED=false

# X5 Keycloak gateway in front of BotX (wiki DPP «Под капотом у ROOMS bot-а»). Leave ROOMS_KC_URL empty for plain BotX.
# KC_URL: Keycloak token endpoint, client_credentials (kc_client_id / kc_client_secret)
ROOMS_KC_URL=
ROOMS_KC_CLIENT_ID=
ROOMS_KC_CLIENT_SECRET=
# header carrying the Keycloak token — name NOT shown on the wiki page, confirm with DPP
ROOMS_KC_HEADER=X-Keycloak-Token
# TOKEN_URL: GET ...?signature=<HMAC-SHA256(BOT_SECRET, BOT_ID)> -> {"result": bot_token}
ROOMS_TOKEN_URL=
# SEND_URL: POST {"group_chat_id", "notification": {"status": "ok", "body", ...}}
ROOMS_SEND_URL=

# Approved internal Linux Python 3.12 image, preferably pinned by digest.
PYTHON_IMAGE=
PORT=8080

# --- ИИ-ответ по базе знаний (RAG) ---
# Выключен по умолчанию: бот работает строго по меню и поиску, как в MVP.
# AI_ENABLED=true требует AI_URL и AI_MODEL. Модель должна быть внутри контура.
AI_ENABLED=false
# X5 AI-Run для клиентских систем (бот — клиентская система):
#   PROD: https://direct-llm.airun.x5.ru/v1   DEV: https://direct-llm.k8s.airun-dev-13.salt.x5.ru/v1
#   Нужен сетевой доступ: группа airun-app-prod-4 в «Сетевые доступы» Salt X5 (по согласованию с ИБ).
#   Модель: x5-airun-small — быстрая, без рассуждений по умолчанию. Не берите *-thinking.
# Адрес OpenAI-совместимого API вместе с /v1 (X5 CoPilot, vLLM, Ollama, LiteLLM, TGI)
AI_URL=
# Имя модели, как её отдаёт GET {AI_URL}/models
AI_MODEL=
AI_API_KEY=
# Заголовок для ключа. Authorization -> «Bearer ключ» (стандарт OpenAI); иначе, например api-key, ключ передаётся как есть
AI_AUTH_HEADER=Authorization
# Отключать «рассуждения» моделей Qwen3 (шлюз X5): быстрее и не съедает лимит токенов.
# Шлюз, не знающий параметр, бот переспросит без него сам.
AI_DISABLE_THINKING=true
# Переменные из .env проекта innolib тоже понимаются: LLM_URL, LLM_MODEL, LLM_CHAT_MODEL, LLM_API_KEY,
# LLM_TIMEOUT, LLM_EXTRA_JSON, LLM_CA_BUNDLE, LLM_VERIFY_TLS, LLM_USE_SYSTEM_PROXY, EMBED_MODEL, EMBED_URL
# Таймаут одного запроса. Ответ считается до ACK в BotX — держите меньше таймаута шлюза.
AI_TIMEOUT=30
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=500
# Эмбеддинги необязательны: без них поиск работает на BM25. Задайте модель для гибридного поиска.
AI_EMBED_MODEL=
AI_EMBED_URL=
# Корпоративный CA и прокси
AI_CA_FILE=
AI_VERIFY_TLS=true
AI_USE_SYSTEM_PROXY=false
# Доп. поля запроса к модели, JSON: {"top_p": 0.9}
AI_EXTRA_JSON=
# С какого числа слов вопрос уходит в модель (1-2 слова — обычный поиск по справочнику)
AI_MIN_WORDS=2
