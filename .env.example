# Скопируйте в .env и заполните. Секреты в репозиторий не коммитить.

# --- Rooms Bot API ---
ROOMS_API_BASE_URL=https://rooms-api.x5.ru        # базовый URL Bot API Rooms (пусто = ответы только в лог)
ROOMS_BOT_TOKEN=                                  # токен бота, выдаёт команда Rooms
ROOMS_SEND_PATH=/api/v1/bot/messages              # метод отправки сообщения (уточнить по документации Rooms)
ROOMS_WEBHOOK_SECRET=                             # секрет, который Rooms передаёт в заголовке X-Rooms-Token
ROOMS_BUTTONS_MODE=inline                         # inline — кнопки в сообщении; text — нумерованный список
ROOMS_VERIFY_TLS=true                             # false, если в контуре самоподписанный сертификат
ROOMS_TIMEOUT_S=10

# --- Бот ---
CONTENT_DIR=content
DB_PATH=data/journal.sqlite3
SESSION_TTL_MIN=240                               # сеанс считается новым после N минут тишины
JOURNAL_USER_MODE=plain                           # plain — id участника Rooms как есть (ручная привязка к ПИ); hash — хеш
JOURNAL_SALT=change-me-random-string              # соль для хеша (режим hash)
LOG_FREE_TEXT=true                                # писать ли в журнал текст вопросов без ответа (канал сбора вопросов)
SEARCH_ENABLED=false                              # v11: только меню; true включает поиск по словам (экран S5)
FREE_TEXT_MAX_LEN=200
CONTENT_STRICT=true                               # не стартовать при ошибках содержания

# --- Служебное ---
DEMO_CONSOLE=true                                 # веб-консоль для приёмки на /  (в проде выключить)
METRICS_TOKEN=                                    # если задан — /metrics/* требуют заголовок X-Metrics-Token
PORT=8080
